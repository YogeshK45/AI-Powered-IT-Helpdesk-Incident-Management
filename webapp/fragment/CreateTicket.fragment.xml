<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">
    <Dialog id="createTicketDialog" title="Create New Ticket" contentWidth="500px">
        <content>
            <f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="1" columnsL="1" columnsM="1" singleContainerFullSize="false">
                <f:content>
                    <Label text="Title" required="true" />
                    <Input value="{newTicket>/Title}" placeholder="Short description of the issue" />
                    
                    <Label text="Description" required="true" />
                    <TextArea value="{newTicket>/Description}" rows="4" />
                    
                    <Label text="Category" required="true" />
                    <ComboBox selectedKey="{newTicket>/Category}">
                        <core:Item key="Network" text="Network" />
                        <core:Item key="Hardware" text="Hardware" />
                        <core:Item key="Software" text="Software" />
                        <core:Item key="SAP" text="SAP" />
                        <core:Item key="Security" text="Security" />
                    </ComboBox>

                    <Label text="Priority" required="true" />
                    <ComboBox selectedKey="{newTicket>/Priority}">
                        <core:Item key="Critical" text="Critical" />
                        <core:Item key="High" text="High" />
                        <core:Item key="Medium" text="Medium" />
                        <core:Item key="Low" text="Low" />
                    </ComboBox>
                </f:content>
            </f:SimpleForm>
        </content>
        <beginButton>
            <Button text="Create" type="Emphasized" press=".onCreateDialogSubmit" />
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onCreateDialogClose" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
