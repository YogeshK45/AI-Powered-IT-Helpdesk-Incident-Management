<mvc:View
    controllerName="it.helpdesk.incident.controller.SlaEscalations"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core">
    <f:DynamicPage id="slaPage">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="SLA &amp; Escalations"/>
                </f:heading>
                <f:expandedContent>
                    <Label text="Critical, At-Risk, and Breached Tickets"/>
                </f:expandedContent>
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
            <Table id="slaTable"
                   items="{path: 'data>/Tickets', templateShareable: false}"
                   class="sapUiResponsiveMargin">
                <columns>
                    <Column><Text text="Ticket ID"/></Column>
                    <Column><Text text="Title"/></Column>
                    <Column><Text text="Priority"/></Column>
                    <Column><Text text="SLA Status"/></Column>
                    <Column><Text text="Assigned To"/></Column>
                    <Column><Text text="Support Team"/></Column>
                    <Column><Text text="Due Date"/></Column>
                    <Column><Text text="Escalation Level"/></Column>
                </columns>
                <items>
                    <ColumnListItem type="Navigation" press=".onTicketPress">
                        <cells>
                            <ObjectIdentifier title="{data>TicketID}" />
                            <Text text="{data>Title}" />
                            <ObjectStatus text="{data>Priority}" state="{
                                path: 'data>Priority',
                                formatter: '.formatter.priorityState'
                            }" />
                            <ObjectStatus text="{
                                path: 'data>SLAStatus',
                                formatter: '.formatter.slaText'
                            }" state="{
                                path: 'data>SLAStatus',
                                formatter: '.formatter.slaState'
                            }" />
                            <Text text="{data>AssignedTo}" />
                            <Text text="{data>SupportTeam}" />
                            <Text text="{
                                path: 'data>DueDate',
                                formatter: '.formatter.formatDate'
                            }" />
                            <ObjectStatus text="{
                                parts: [
                                    {path: 'data>Priority'},
                                    {path: 'data>SLAStatus'}
                                ],
                                formatter: '.formatter.escalationLevel'
                            }" state="{
                                parts: [
                                    {path: 'data>Priority'},
                                    {path: 'data>SLAStatus'}
                                ],
                                formatter: '.formatter.escalationState'
                            }" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </f:content>
    </f:DynamicPage>
</mvc:View>
